{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": {
        "src": "{{DIVINE_SYSTEM_ROOT}}/",
        "files": [
          "src/Divine/src/Divine/*.csproj",
          "src/Divine/src/Divine.Extensions/*.csproj",
          "artifacts/bin/Divine.Common/Release/Divine.Common.dll",
          "artifacts/bin/Divine.Protobufs/Release/Divine.Protobufs.dll"
        ]
      },
      "properties": {
        "AppBasePath": "{{DIVINE_SYSTEM_ROOT}}/artifacts/Release/",
        "IsInternal": "true",
        "SolutionDir": "{{DIVINE_SYSTEM_ROOT}}/",
        "SolutionName": "Divine.System",
        "TargetFramework": "net11.0"
      },
      "outputFormat": "mref",
      "dest": "_generated/api",
      "references": [
        {
          "src": "{{DIVINE_SYSTEM_ROOT}}/artifacts/bin/Divine.Dependencies/Release/",
          "files": [
            "System.CommandLine.dll",
            "Google.Protobuf.dll",
            "CommunityToolkit.Mvvm.dll",
            "DistributedLock.FileSystem.dll",
            "Refit.dll",
            "Karambolo.Extensions.Logging.File.dll",
            "CircularBuffer.dll",
            "Reloaded.Memory.dll",
            "System.Interactive.dll",
            "Refit.HttpClientFactory.dll",
            "Humanizer.dll",
            "DistributedLock.Core.dll"
          ]
        }
      ]
    },
    {
      "src": {
        "src": "{{DIVINE_SYSTEM_ROOT}}/",
        "files": [
          "src/Divine/src/Divine/*.csproj",
          "src/Divine/src/Divine.Extensions/*.csproj",
          "artifacts/bin/Divine.Common/Release/Divine.Common.dll",
          "artifacts/bin/Divine.Protobufs/Release/Divine.Protobufs.dll"
        ]
      },
      "properties": {
        "AppBasePath": "{{DIVINE_SYSTEM_ROOT}}/artifacts/Release/",
        "IsInternal": "true",
        "SolutionDir": "{{DIVINE_SYSTEM_ROOT}}/",
        "SolutionName": "Divine.System",
        "TargetFramework": "net11.0"
      },
      "outputFormat": "markdown",
      "dest": "_generated/markdown",
      "references": [
        {
          "src": "{{DIVINE_SYSTEM_ROOT}}/artifacts/bin/Divine.Dependencies/Release/",
          "files": [
            "System.CommandLine.dll",
            "Google.Protobuf.dll",
            "CommunityToolkit.Mvvm.dll",
            "DistributedLock.FileSystem.dll",
            "Refit.dll",
            "Karambolo.Extensions.Logging.File.dll",
            "CircularBuffer.dll",
            "Reloaded.Memory.dll",
            "System.Interactive.dll",
            "Refit.HttpClientFactory.dll",
            "Humanizer.dll",
            "DistributedLock.Core.dll"
          ]
        }
      ]
    }
  ],
  "build": {
    "content": [
      {
        "src": "src/Divine.DocFx/DocFx/",
        "files": "**/*.{md,yml}"
      },
      {
        "src": "_generated/api/",
        "files": "**/*.yml",
        "dest": "api"
      }
    ],
    "resource": [
      {
        "src": "_generated/markdown/",
        "files": "**/*.md",
        "dest": "markdown/api"
      },
      {
        "src": "src/Divine.DocFx/DocFx/",
        "files": "images/**"
      }
    ],
    "output": "_site",
    "template": [
      "default",
      "modern"
    ],
    "globalMetadata": {
      "_appName": "Divine",
      "_appTitle": "Divine",
      "_enableSearch": true,
      "pdf": false
    }
  }
}
